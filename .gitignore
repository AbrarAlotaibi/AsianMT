# Generated cleaning output (regenerable from raw with scripts/clean.py)
*/clean/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Model checkpoints, logs, predictions, eval artifacts
checkpoints/
runs/
outputs/
predictions/
wandb/

